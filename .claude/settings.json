{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm exec *)",
      "Bash(npx shadcn@latest *)",
      "Bash(npm test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout -b*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(rg*)",
      "Bash(mkdir*)",
      "Read(**)",
      "Edit(**)",
      "Write(**)"
    ],
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(npm install*)",
      "Bash(npm add*)",
      "Bash(pnpm *)",
      "Bash(yarn *)",
      "Bash(curl*)",
      "Bash(wget*)",
      "Read(./.env*)",
      "Edit(./src/components/ui/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx biome check --write --no-errors-on-unmatched . >/dev/null 2>&1 || true",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "npx tsc -b --noEmit", "timeout": 120 }]
      }
    ]
  }
}
